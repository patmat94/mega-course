{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__mega-challenge__claim-challenge",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/claim-gate.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/log-append-only.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/recheck-sources.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
